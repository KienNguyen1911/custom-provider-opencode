{
  "name": "custom-provider-opencode",
  "version": "0.1.0",
  "description": "Interactive provider and model manager for OpenCode — add any OpenAI-compatible provider with /provider",
  "type": "module",
  "license": "MIT",
  "author": "Kien Nguyen",
  "homepage": "https://github.com/KienNguyen1911/custom-provider-opencode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KienNguyen1911/custom-provider-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/KienNguyen1911/custom-provider-opencode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "provider",
    "openai-compatible",
    "models",
    "tui"
  ],
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.js"
  },
  "files": [
    "index.js",
    "tui.js",
    "picker.js",
    "picker.jsx",
    "provider-manager.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check tui.js && node --check picker.js",
    "build:picker": "esbuild picker.jsx --jsx=automatic --jsx-import-source=@opentui/solid --format=esm --outfile=picker.js",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
